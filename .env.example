# Bắt buộc để dùng AI (miễn phí tại https://aistudio.google.com/apikey).
# Không có key: app vẫn chạy, AI trả lịch trình mẫu.
GEMINI_API_KEY=

# Tùy chọn: đổi model Gemini mà không cần sửa code.
GEMINI_MODEL=gemini-3.7-flash

# Tùy chọn: tìm địa điểm thật từ Google Maps qua SerpApi (quota free rất nhỏ).
# Không có key: dùng dữ liệu địa điểm nội bộ.
SERPAPI_API_KEY=
# Bật gợi ý khi gõ (tốn quota SerpApi rất nhanh). Mặc định tắt.
SERPAPI_AUTOCOMPLETE=false
